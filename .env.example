# Local development defaults. Never use fake AI or dev auth for public hosting.
ENVIRONMENT=development
ENABLE_DEV_AUTH=true
AI_PROVIDER=fake
APP_ORIGIN=http://localhost:8080
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
SECRET_KEY=development-only-change-before-production-32-chars
POSTGRES_USER=socralife
POSTGRES_DB=socralife
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://socralife:local-development-only@db:5432/socralife
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=
VISION_MODEL=MiniCPM-V-4.6
CHAT_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
MODEL_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=2000
DAILY_GENERATION_LIMIT=30
GLOBAL_DAILY_MODEL_LIMIT=1000
STORAGE_LIMIT_BYTES=524288000
MAX_FILE_BYTES=52428800
STORAGE_PROVIDER=local
STORAGE_ROOT=/data/files
DELETION_LEDGER_PATH=/data/deletions/deletions.jsonl
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Remote encrypted backup repository (e.g. s3:https://host/bucket/path).
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
