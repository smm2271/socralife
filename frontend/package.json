{
  "name": "socralife-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "npm run contracts:check && vitest run",
    "test:e2e": "playwright test",
    "contracts": "node scripts/generate-ui.mjs",
    "contracts:check": "node scripts/generate-ui.mjs --check",
    "prebuild": "npm run contracts"
  },
  "dependencies": {
    "@angular/animations": "22.1.5",
    "@angular/cdk": "22.1.3",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.5",
    "ajv": "8.20.0",
    "echarts": "6.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@playwright/test": "1.58.2",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
